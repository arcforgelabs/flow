# Replit template for running a pinned Flow npm release (docs/SELF_HOSTING.md).
# Copy this folder into your own private deploy repository. To run a Replit
# workspace of the Flow repository itself, which follows a release channel,
# use the .replit at the repository's root instead (docs/REPLIT.md).
modules = ["nodejs-24", "bash"]
run = ["bash", "start.sh"]

[env]
FLOW_RUNTIME = "replit"

[[ports]]
localPort = 19300
externalPort = 80

# Reserved VM: Flow runs its integration outbox and scheduled invoice email
# in-process, so it must stay up (an autoscale deployment would sleep and miss
# them).
[deployment]
deploymentTarget = "vm"
build = ["bash", "install-and-verify.sh"]
run = ["bash", "start.sh"]
ignorePorts = false
