# Replit settings for a workspace imported from this repository
# (docs/REPLIT.md). The workspace's Run button builds what the next publish
# will build and, with that build's tools, brings the workspace's database to
# exactly the migrations production runs (scripts/replit-workspace-db.js), so
# publishing shows no "Development database changes detected". If it does,
# press Cancel. The deployment builds and runs a release or commit fetched
# from GitHub: FLOW_DEPLOY_REF=stable, beta, a release tag or a commit; main
# when unset (scripts/replit-deploy.sh). onBoot starts the workspace updater,
# which does what Run does by itself, every 10 minutes. Keep every secret in
# Replit Secrets.
modules = ["nodejs-24", "bash"]
run = ["bash", "scripts/replit-deploy.sh", "update-workspace"]
onBoot = "bash scripts/replit-deploy.sh boot"

[env]
FLOW_RUNTIME = "replit"

[[ports]]
localPort = 19300
externalPort = 80

# Reserved VM: Flow runs its integration outbox and scheduled invoice email
# in-process, so it must stay up (an autoscale deployment would sleep and miss
# them).
[deployment]
deploymentTarget = "vm"
build = ["bash", "scripts/replit-deploy.sh", "build"]
run = ["bash", "scripts/replit-deploy.sh", "start"]
ignorePorts = false
