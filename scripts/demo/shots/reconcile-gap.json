{
  "title": "Jobs with no invoice",
  "seed": "reconcile-gap",
  "start": "/reconcile",
  "steps": [
    {
      "do": "hover",
      "target": "tbody tr:first-child",
      "hold": 1500
    },
    {
      "do": "click",
      "target": "tbody tr:first-child",
      "expect": "button:visible:has-text('Link this invoice') >> nth=0"
    },
    {
      "do": "wait",
      "ms": 1500,
      "hold": 3000
    },
    {
      "do": "click",
      "target": "button:visible:has-text('Link this invoice') >> nth=0",
      "expect": "text=Linked to the draft.",
      "hold": 2500
    },
    {
      "do": "click",
      "target": "a[data-nav='invoices']"
    },
    {
      "do": "click",
      "target": "[role='tab']:has-text('Ready')"
    },
    {
      "do": "click",
      "target": "tr:has-text('SYNTHETIC-GAP') a[href^='/invoices/']",
      "hold": 1500,
      "expect": "text=SYNTHETIC-GAP"
    },
    {
      "do": "wait",
      "ms": 1500,
      "hold": 3000
    }
  ]
}
