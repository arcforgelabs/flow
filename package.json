{
  "name": "@arcforgelabs/flow",
  "version": "2026.11.16",
  "description": "Invoicing, bill entry and a financial dashboard for labs, with Seazona and Xero integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcforgelabs/flow.git"
  },
  "homepage": "https://github.com/arcforgelabs/flow#readme",
  "bugs": {
    "url": "https://github.com/arcforgelabs/flow/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "flow-server": "./server/flow-server.js"
  },
  "files": [
    "server/",
    "skills/",
    "SECURITY.md",
    "VISION.md",
    "npm-shrinkwrap.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "changelog:check": "node scripts/release/changelog.mjs check",
    "release:stable": "node scripts/release/release-stable.mjs",
    "theme:contrast": "node scripts/theme-contrast.mjs",
    "db:generate": "drizzle-kit generate && node scripts/db-guard-migrations.js",
    "db:follow-production": "node scripts/replit-workspace-db.js sync",
    "db:follow-production:status": "node scripts/replit-workspace-db.js status",
    "design-system": "node scripts/design-system/build.mjs",
    "test:mobile": "playwright test -c test/mobile/playwright.config.js",
    "test:mobile:budget": "node test/mobile/budget.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.27.0",
    "@clerk/express": "2.1.88",
    "@clerk/mcp-tools": "0.9.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sentry/node": "11.11.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "lucide-static": "1.71.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "light-my-request": "6.8.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
