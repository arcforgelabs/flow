{
  "name": "@arcforgelabs/flow",
  "version": "2026.10.33",
  "description": "Invoicing, bill entry and a financial dashboard for labs, with Seazona and Xero integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcforgelabs/flow.git"
  },
  "homepage": "https://github.com/arcforgelabs/flow#readme",
  "bugs": {
    "url": "https://github.com/arcforgelabs/flow/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "flow-server": "./server/flow-server.js"
  },
  "files": [
    "server/",
    "SECURITY.md",
    "VISION.md",
    "npm-shrinkwrap.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "theme:contrast": "node scripts/theme-contrast.mjs",
    "db:generate": "drizzle-kit generate && node scripts/db-guard-migrations.js"
  },
  "dependencies": {
    "@clerk/backend": "3.23.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@sentry/node": "11.4.0",
    "drizzle-orm": "0.45.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
