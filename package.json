  },
  "dependencies": {
    "@clerk/backend": "3.23.2",
    "drizzle-orm": "0.45.3",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
